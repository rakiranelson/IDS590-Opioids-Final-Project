   "source": [
    "opioids_prescriptions = pd.read_csv(\"data/opioids_clean.csv\")\n",
    "opioids_prescriptions = opioids_prescriptions.copy()\n",
    "opioids_prescriptions = opioids_prescriptions.drop(columns=[\"Unnamed: 0\"])"
   ]
  },
  {
